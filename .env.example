# Postgres credentials (used by both the db and app service in docker-compose)
POSTGRES_USER=patchwatch
POSTGRES_PASSWORD=change-me
POSTGRES_DB=patchwatch

# How often the background scheduler checks all sources for new patches (hours)
FETCH_INTERVAL_HOURS=6

# Run one fetch immediately when the app container starts
FETCH_ON_STARTUP=true

# Minimum minutes between two refreshes triggered by page visits (debounce)
MIN_REFRESH_INTERVAL_MINUTES=15

LOG_LEVEL=INFO

# --- Fetching (see README "Known limitations") ---
# Default timeout per request, and a longer one for MSRC's big monthly CVRF docs
# REQUEST_TIMEOUT_SECONDS=30
# MSRC_CVRF_TIMEOUT_SECONDS=90
# Retries on 403/429/5xx/timeouts; the wait doubles per attempt from this base
# HTTP_MAX_RETRIES=3
# HTTP_RETRY_BACKOFF_SECONDS=2
# Minimum gap between requests to support.microsoft.com (never sent in parallel)
# SUPPORT_SITE_MIN_INTERVAL_SECONDS=1

# HTTP Basic Auth password for /admin (manual patch corrections + force
# refresh). Username is fixed as "admin". Change this before the app is ever
# reachable from outside localhost.
ADMIN_PASSWORD=change-me

# --- Notifications (ntfy, see README "Notifications") ---
# Full ntfy topic URL to push new-patch notifications to. Leave unset to
# disable notifications entirely.
# NTFY_URL=https://ntfy.sh/my-private-patchwatch-topic
# Only needed for a reserved/private ntfy.sh topic or an access-controlled
# self-hosted ntfy instance.
# NTFY_TOKEN=
# Opened when the notification itself is tapped/clicked, e.g. your instance's
# public URL.
# PUBLIC_BASE_URL=

# --- DB backups (db-backup service) ---
# Cron schedule for automatic pg_dump backups (see README "Backups")
BACKUP_SCHEDULE=@daily
# Rotation: how many daily/weekly/monthly backups to keep before pruning
BACKUP_KEEP_DAYS=30
BACKUP_KEEP_WEEKS=12
BACKUP_KEEP_MONTHS=12
